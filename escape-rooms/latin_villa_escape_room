</div>

<script>
  // ---------- helpers ----------
  const norm = s => s.toLowerCase().trim().replace(/\s+/g,' ')
    .replace(/ā/g,'a').replace(/ē/g,'e').replace(/ī/g,'i').replace(/ō/g,'o').replace(/ū/g,'u').replace(/ȳ/g,'y');

  const answers = {
    q1a:['puellae'], q1c:['terra'], q1d:['stellis'],
    q2b:['dona'], q2c:['amice'],
    q3a:['amat'], q3b:['portamus'],
    q4b:['vident'], q4d:['tenes']
  };
  const rooms = {1:['q1a','q1b','q1c','q1d','q1e'],2:['q2a','q2b','q2c','q2d'],3:['q3a','q3b','q3c','q3d','q3e'],4:['q4a','q4b','q4c','q4d']};
  const solved = new Set();
  const praise = ['Optimē! ✨','Euge! 🌿','Bene! 💜','Rēctē! ⭐','Fantastic! 🎉'];
  const nudge  = ['Not quite — try again!','Almost! Check the ending.','Hmm, Bubō shakes his head. Try again!','Close! Look at the hint if you need it.'];

  // ---------- Bubō the owl ----------
  const owlHappy = ['Hoot! Optimē! 🎉','Bubō approves! 💜','Euge, discipula! ⭐','Sīc! That is it! 🌿','My feathers are impressed! ✨'];
  const owlSad   = ['Hoo-hmm… try once more!','Not yet, little Roman!','Bubō believes in you! 🌿','So close I can taste it. And I eat mice.'];
  const owlKey   = ['A KEY! Hoot hoot! 🗝️','Splendid! On to the next room! 🎉','You are unstoppable! 🗝️✨'];
  let owlTimer = null;
  function owlSay(msg, jump){
    const b = document.getElementById('owlbubble');
    const o = document.getElementById('owlsvg');
    b.textContent = msg; b.classList.add('show');
    if(jump){ o.classList.remove('happy'); void o.offsetWidth; o.classList.add('happy'); }
    clearTimeout(owlTimer);
    owlTimer = setTimeout(()=>b.classList.remove('show'), 3200);
  }
  setTimeout(()=>owlSay('Salvē! I am Bubō, guardian of the villa. 🌿'), 800);

  // ---------- timer ----------
  let secs = 0, tint = null;
  function startGame(){
    document.getElementById('s0').classList.remove('active');
    document.getElementById('s1').classList.add('active');
    document.getElementById('hud').style.display = 'flex';
    tint = setInterval(()=>{ secs++;
      const m = String(Math.floor(secs/60)).padStart(2,'0'), s = String(secs%60).padStart(2,'0');
      document.getElementById('timer').textContent = m+':'+s;
    },1000);
    window.scrollTo({top:0});
  }

  function goTo(n){
    document.querySelectorAll('.screen').forEach(el=>el.classList.remove('active'));
    document.getElementById('s'+n).classList.add('active');
    document.getElementById('pfill').style.width = ((n-1)/5*100)+'%';
    window.scrollTo({top:0,behavior:'smooth'});
  }

  function markSolved(qid){
    if(solved.has(qid)) return;
    solved.add(qid);
    const q = document.getElementById(qid);
    q.classList.add('solved');
    const fb = q.querySelector('.feedback');
    fb.textContent = praise[Math.floor(Math.random()*praise.length)];
    fb.className = 'feedback good';
    let gotKey = false;
    // room complete?
    for(const [rn, qs] of Object.entries(rooms)){
      if(qs.includes(qid) && qs.every(id=>solved.has(id))){
        const numerals = {1:'V',2:'III',3:'I',4:'II'};
        document.getElementById('key'+rn).classList.add('show');
        const slot = document.getElementById('k'+rn);
        slot.textContent = numerals[rn]; slot.classList.add('filled');
        const door = document.getElementById('door'+rn);
        door.classList.add('open');
        door.querySelector('.bigbtn').disabled = false;
        gotKey = true;
        miniBurst();
      }
    }
    owlSay(gotKey ? owlKey[Math.floor(Math.random()*owlKey.length)]
                  : owlHappy[Math.floor(Math.random()*owlHappy.length)], true);
  }

  function wrongAnswer(q){
    const fb = q.querySelector('.feedback');
    fb.textContent = nudge[Math.floor(Math.random()*nudge.length)];
    fb.className = 'feedback bad';
    owlSay(owlSad[Math.floor(Math.random()*owlSad.length)], false);
  }

  // ---------- wire up type-in questions ----------
  document.querySelectorAll('.q').forEach(q=>{
    const qid = q.id;
    const input = q.querySelector('.typein input');
    const btn = q.querySelector('.typein .check');
    if(input && btn && answers[qid]){
      const tryIt = ()=>{
        if(answers[qid].includes(norm(input.value))) markSolved(qid);
        else wrongAnswer(q);
      };
      btn.addEventListener('click', tryIt);
      input.addEventListener('keydown', e=>{ if(e.key==='Enter') tryIt(); });
    }
    // multiple choice
    q.querySelectorAll('button.choice').forEach(c=>{
      c.addEventListener('click', ()=>{
        if(solved.has(qid)) return;
        if(c.dataset.ok==='1'){ c.classList.add('correct'); markSolved(qid); }
        else { c.classList.add('wrong'); wrongAnswer(q); setTimeout(()=>c.classList.remove('wrong'),600); }
      });
    });
    // hints
    const hb = q.querySelector('.hintbtn');
    if(hb) hb.addEventListener('click', ()=> q.querySelector('.hinttext').classList.toggle('show'));
  });

  // ---------- final code ----------
  const codeInputs = document.querySelectorAll('.final-code input');
  codeInputs.forEach((inp,i)=>{
    inp.addEventListener('input', ()=>{ if(inp.value && i<3) codeInputs[i+1].focus(); });
  });
  document.getElementById('codebtn').addEventListener('click', ()=>{
    const q = document.getElementById('q5c');
    const fb = q.querySelector('.feedback');
    if(!solved.has('q5a') || !solved.has('q5b')){
      fb.textContent = 'Translate both inscriptions first!'; fb.className='feedback bad'; return;
    }
    const code = Array.from(codeInputs).map(i=>i.value.trim()).join('');
    if(code === '5312'){
      markSolved('q5c');
      clearInterval(tint);
      const m = Math.floor(secs/60), s = secs%60;
      document.getElementById('finaltime').textContent = 'Escape time: '+m+' min '+s+' sec';
      document.getElementById('pfill').style.width = '100%';
      goTo(6);
      celebrate();
    } else { fb.textContent='The lock will not turn. Check your numerals!'; fb.className='feedback bad'; }
  });

  // ---------- emoji match games ----------
  document.querySelectorAll('.matchgrid').forEach(grid=>{
    const q = grid.closest('.q');
    const qid = q.id;
    let pickedWord = null, pickedEmoji = null, matched = 0;
    const total = grid.querySelectorAll('.mword').length;
    function clearPicks(){
      grid.querySelectorAll('.picked').forEach(b=>b.classList.remove('picked'));
      pickedWord = pickedEmoji = null;
    }
    function judge(){
      if(!pickedWord || !pickedEmoji) return;
      if(pickedWord.dataset.pair === pickedEmoji.dataset.pair){
        pickedWord.classList.remove('picked'); pickedEmoji.classList.remove('picked');
        pickedWord.classList.add('matched'); pickedEmoji.classList.add('matched');
        pickedWord = pickedEmoji = null;
        matched++;
        if(matched === total){ markSolved(qid); }
        else {
          const fb = q.querySelector('.feedback');
          fb.textContent = 'Match! '+(total-matched)+' to go 🎯';
          fb.className = 'feedback good';
        }
      } else {
        const w = pickedWord, e = pickedEmoji;
        w.classList.add('nope'); e.classList.add('nope');
        setTimeout(()=>{ w.classList.remove('nope'); e.classList.remove('nope'); }, 500);
        clearPicks();
        wrongAnswer(q);
      }
    }
    grid.querySelectorAll('.mword').forEach(b=>b.addEventListener('click', ()=>{
      if(b.classList.contains('matched')) return;
      if(pickedWord) pickedWord.classList.remove('picked');
      pickedWord = b; b.classList.add('picked'); judge();
    }));
    grid.querySelectorAll('.memoji').forEach(b=>b.addEventListener('click', ()=>{
      if(b.classList.contains('matched')) return;
      if(pickedEmoji) pickedEmoji.classList.remove('picked');
      pickedEmoji = b; b.classList.add('picked'); judge();
    }));
  });

  // ---------- confetti ----------
  function dropConfetti(count){
    const bits = ['💜','🌿','⭐','🌸','💙','💚','✨','🦉','🌹','🎉'];
    for(let i=0;i<count;i++){
      const el = document.createElement('div');
      el.className='confetti'; el.textContent = bits[Math.floor(Math.random()*bits.length)];
      el.style.left = Math.random()*100+'vw';
      el.style.fontSize = (1+Math.random()*1.2)+'rem';
      el.style.animationDuration = (2.2+Math.random()*2.4)+'s';
      el.style.animationDelay = (Math.random()*0.9)+'s';
      document.body.appendChild(el);
      setTimeout(()=>el.remove(),6000);
    }
  }
  function miniBurst(){ dropConfetti(16); }
  function celebrate(){
    owlSay('LĪBERA ES! Hoot hoot hooray! 🎉🗝️', true);
    dropConfetti(70);

        <div class="matchrow">
          <button class="memoji" data-pair="carry" aria-label="carries">🎒</button>
          <button class="memoji" data-pair="sing" aria-label="sings">🎶</button>
          <button class="memoji" data-pair="love" aria-label="loves">❤️</button>
          <button class="memoji" data-pair="praise" aria-label="praises">👏</button>
          <button class="memoji" data-pair="call" aria-label="calls">📣</button>
